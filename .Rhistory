# -----------------------------------------------------------------------------
dir.create("10.GO_analysis/results_topGO_260829", recursive = TRUE, showWarnings = FALSE)
col_order <- c("GO.ID", "Term_full", "Ontology", "Annotated", "Significant",
"Expected", "PValue", "Gene_IDs", "Gene_symbols", "Algorithm")
