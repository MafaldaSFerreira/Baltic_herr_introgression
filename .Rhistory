# -----------------------------------------------------------------------------
# 3. GO annotation and gene -> GO map
# -----------------------------------------------------------------------------
go_terms_raw <- getBM(
attributes = c("ensembl_gene_id", "external_gene_name",
"go_id", "name_1006", "namespace_1003"),
mart = mart109
)
# Drop the empty placeholder rows for genes with no GO annotation.
go_terms <- go_terms_raw %>% filter(!is.na(go_id), go_id != "")
message("genes returned by biomaRt: ", n_distinct(go_terms_raw$ensembl_gene_id))
#genes returned by biomaRt: 27879
message("genes with >=1 real GO term: ", n_distinct(go_terms$ensembl_gene_id))
gene2GO <- by(go_terms$go_id, go_terms$ensembl_gene_id,
function(x) as.character(unique(x)))
gene2GO <- as.list(gene2GO)
# Universe = all annotated genes genome-wide. This is a defensible default, but
# be ready to justify it: a reviewer could argue the background should be
# restricted to genes in regions with comparable power to detect introgression.
allGenes <- names(gene2GO)
geneList        <- factor(as.integer(allGenes %in% myGenes))
names(geneList) <- allGenes
table(geneList)
# How many of the 166 survive into the annotated universe at all. This is
# already lower than 166 and drops further per ontology (see section 5).
sum(geneList == 1)
# -----------------------------------------------------------------------------
# 4. topGO wrapper
# -----------------------------------------------------------------------------
# adjust   = apply BH across all terms tested in this ontology. Use TRUE for
#            classic only; leave FALSE for weight01/elim.
# nodeSize = minimum number of annotated genes for a term to be tested.
run_topGO <- function(geneList, gene2GO, ontology,
what_alg = "weight01", what_stat = "fisher",
nodeSize = 5, adjust = FALSE) {
GOdata <- new("topGOdata",
ontology = ontology,
allGenes = geneList,
annot    = annFUN.gene2GO,
gene2GO  = gene2GO,
nodeSize = nodeSize)
res <- runTest(GOdata, algorithm = what_alg, statistic = what_stat)
# score() returns a named numeric vector covering every term tested:
# no character coercion, no "< 1e-30", no truncation.
pv <- score(res)
# termStat() supplies Annotated / Significant / Expected for the same terms.
ts <- termStat(GOdata) |> rownames_to_column("GO.ID")
out <- data.frame(GO.ID = names(pv),
PValue = as.numeric(pv),
stringsAsFactors = FALSE) |>
left_join(ts, by = "GO.ID") |>
mutate(Ontology  = ontology,
Algorithm = what_alg) |>
arrange(PValue)
# Correction runs over the full set of tested terms, not a truncated top-N.
if (adjust) out$PValue_FDR <- p.adjust(out$PValue, method = "BH")
# Carry the GOdata object so genesInTerm() can be used later. Note this
# attribute is dropped by bind_rows(), so gene annotation must be added to
# the per-ontology objects before they are combined.
attr(out, "GOdata") <- GOdata
out
}
# -----------------------------------------------------------------------------
# 5. Run both algorithms across the three ontologies
# -----------------------------------------------------------------------------
onts <- c("BP", "MF", "CC")
# Primary: weight01, raw p-values (no correction — see header note 4).
weight01 <- lapply(onts, function(o)
run_topGO(geneList, gene2GO, o, "weight01", "fisher", nodeSize = 5, adjust = FALSE))
names(weight01) <- onts
# Sensitivity: classic Fisher with BH correction.
classic <- lapply(onts, function(o)
run_topGO(geneList, gene2GO, o, "classic", "fisher", nodeSize = 5, adjust = TRUE))
names(classic) <- onts
# --- Numbers to report in the Methods / table legend --------------------------
# numGenes()  = feasible universe: genes with annotation in this ontology that
#               survive the nodeSize filter.
# sigGenes()  = the subset of the test set that is feasible. In BP this was 67
#               of 166 — the test rests on those 67, not on all 166, and the
#               Results wording should reflect that.
feasibility <- sapply(weight01, function(d) {
g <- attr(d, "GOdata")
c(terms_tested   = length(usedGO(g)),
universe_genes = numGenes(g),
test_genes     = length(sigGenes(g)))
})
print(feasibility)
# -----------------------------------------------------------------------------
# 6. Genes behind each term
# -----------------------------------------------------------------------------
sig_genes <- names(geneList)[geneList == 1]
# Ensembl ID -> symbol map for the whole annotated universe (not just the test
# set), so nothing falls back to a bare ID unnecessarily.
id_map <- go_terms %>%
distinct(ensembl_gene_id, external_gene_name)
add_genes <- function(df) {
GOdata <- attr(df, "GOdata")
# genesInTerm() uses topGO's propagated annotation, so the list length
# matches the Significant column. Direct gene2GO lookup does not.
git <- genesInTerm(GOdata, df$GO.ID)
df$Gene_IDs <- vapply(git, function(g)
paste(intersect(g, sig_genes), collapse = ", "), character(1))
df$Gene_symbols <- vapply(strsplit(df$Gene_IDs, ",\\s*"), function(ids) {
s <- id_map$external_gene_name[match(ids, id_map$ensembl_gene_id)]
s[is.na(s) | s == ""] <- ids[is.na(s) | s == ""]
paste(s, collapse = ", ")
}, character(1))
# Sanity check: these should agree for every row.
n_listed <- lengths(strsplit(df$Gene_IDs, ",\\s*"))
n_listed[df$Gene_IDs == ""] <- 0
if (any(n_listed != df$Significant))
warning("Gene list length disagrees with Significant for ",
sum(n_listed != df$Significant), " terms in ", df$Ontology[1])
df
}
weight01 <- lapply(weight01, add_genes)
classic  <- lapply(classic,  add_genes)
# -----------------------------------------------------------------------------
# 7. Term names
# -----------------------------------------------------------------------------
# getBM(filters = "go") filters genes by GO id and returns all GO terms of the
# matching genes, so the result must be filtered back to the ids requested and
# de-duplicated before joining, or the join will multiply rows.
all_ids <- unique(c(bind_rows(weight01)$GO.ID, bind_rows(classic)$GO.ID))
term_names <- getBM(attributes = c("go_id", "name_1006"),
filters = "go", values = all_ids, mart = mart109) %>%
filter(go_id %in% all_ids, name_1006 != "") %>%
distinct(go_id, .keep_all = TRUE)
term_names <- getBM(attributes = c("go_id", "name_1006"),
filters = "go", values = all_ids, mart = mart109) %>%
filter(go_id %in% all_ids, name_1006 != "") %>%
distinct(go_id, .keep_all = TRUE)
# -----------------------------------------------------------------------------
# 7. Term names
# -----------------------------------------------------------------------------
# getBM(filters = "go") filters genes by GO id and returns all GO terms of the
# matching genes, so the result must be filtered back to the ids requested and
# de-duplicated before joining, or the join will multiply rows.
all_ids <- unique(c(bind_rows(weight01)$GO.ID, bind_rows(classic)$GO.ID))
all_ids
term_names <- getBM(attributes = c("go_id", "name_1006"),
filters = "go", values = all_ids, mart = mart109) %>%
filter(go_id %in% all_ids, name_1006 != "") %>%
distinct(go_id, .keep_all = TRUE)
term_names <- go_terms_raw %>%
filter(go_id != "", !is.na(go_id), name_1006 != "") %>%
distinct(go_id, .keep_all = TRUE) %>%
dplyr::select(go_id, name_1006)
# check coverage before joining
sum(!all_ids %in% term_names$go_id)
#1524
attach_terms <- function(df) {
n_before <- nrow(df)
out <- left_join(df, term_names, by = c("GO.ID" = "go_id")) %>%
rename(Term_full = name_1006)
stopifnot(nrow(out) == n_before)   # guards against duplicate-key blow-up
out
}
go_weight01 <- bind_rows(lapply(weight01, attach_terms))
go_classic  <- bind_rows(lapply(classic,  attach_terms))
go_weight01
head(go_weight01)
# -----------------------------------------------------------------------------
# 8. Compare the two algorithms
# -----------------------------------------------------------------------------
# If the top sets largely agree, the classic-vs-weight01 choice is cosmetic.
# If they diverge, that usually means the signal is concentrated in a few genes
# shared across many nested terms — worth understanding before committing.
top_w <- go_weight01 %>% group_by(Ontology) %>% slice_min(PValue, n = 10) %>% ungroup()
top_c <- go_classic  %>% group_by(Ontology) %>% slice_min(PValue_FDR, n = 10) %>% ungroup()
overlap <- sapply(onts, function(o)
length(intersect(top_w$GO.ID[top_w$Ontology == o],
top_c$GO.ID[top_c$Ontology == o])))
print(overlap)
side_by_side <- full_join(
top_w %>% dplyr::select(Ontology, GO.ID, Term_full, P_weight01 = PValue,
Significant, Annotated, Expected, Gene_symbols),
top_c %>% dplyr::select(Ontology, GO.ID, P_classic = PValue, FDR_classic = PValue_FDR),
by = c("Ontology", "GO.ID")) %>%
arrange(Ontology, P_weight01)
print(side_by_side, n = 40)
View(side_by_side)
# -----------------------------------------------------------------------------
# 9. Are the genes the paper actually discusses in here?
# -----------------------------------------------------------------------------
# If THRB / RHO are annotation-poor in herring Ensembl and dropped out of the
# feasible set, the GO table cannot be presented as supporting the photoreceptor
# argument, and the Results wording needs to change accordingly.
genes_of_interest <- c("thrb", "thrb2", "rho")
anno109 %>%
filter(tolower(external_gene_name) %in% genes_of_interest) %>%
mutate(in_universe = ensembl_gene_id %in% allGenes,
BP_feasible = ensembl_gene_id %in% sigGenes(attr(weight01$BP, "GOdata")))
# Which top terms they appear in, if any
top_w %>% filter(str_detect(tolower(Gene_symbols), "thrb|rho")) %>%
dplyr::select(Ontology, GO.ID, Term_full, Significant, Gene_symbols)
# Also worth checking how thin the top terms are: with 67 feasible BP genes,
# many terms will rest on 3-5 genes.
top_w %>% count(Ontology, Significant)
