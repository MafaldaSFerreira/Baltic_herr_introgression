# Fix previous function to make tests, multiple test corrections more explicit in the call:
run_topGO <- function(geneList, gene2GO, ontology, what_alg, what_stat,
nodeSize = 5, adjust = FALSE) {
GOdata <- new("topGOdata", ontology = ontology, allGenes = geneList,
annot = annFUN.gene2GO, gene2GO = gene2GO, nodeSize = nodeSize)
res <- runTest(GOdata, algorithm = what_alg, statistic = what_stat)
pv  <- score(res)                       # all tested terms, numeric, no "< 1e-30"
out <- data.frame(GO.ID = names(pv), PValue = as.numeric(pv)) |>
left_join(termStat(GOdata) |> tibble::rownames_to_column("GO.ID"),
by = "GO.ID") |>
mutate(Ontology = ontology) |>
arrange(PValue)
if (adjust) out$PValue_FDR <- p.adjust(out$PValue, method = "BH")
# keep the GOdata object so you can recover genes per term later
attr(out, "GOdata") <- GOdata
out
}
