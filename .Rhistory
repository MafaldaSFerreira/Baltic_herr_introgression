plot_dat <- top_w %>%
mutate(logP = -log10(PValue),
Term_wrapped = str_wrap(Term_full, width = 50))
p1 <- ggplot(plot_dat, aes(x = reorder(Term_wrapped, logP), y = logP,
size = Significant)) +
geom_point(aes(colour = Ontology)) +
coord_flip() +
facet_wrap(~Ontology, scales = "free_y", ncol = 1) +
labs(x = "GO term",
y = expression(-log[10]~"("*italic(P)*")  [weight01, unadjusted]"),
size = "Genes in set", colour = "Ontology") +
theme_minimal(base_size = 12) +
theme(strip.text = element_text(size = 7, face = "bold"),
axis.text.y = element_text(size = 7, hjust = 1))
p1
ggsave(p1, filename = "10.GO_analysis/results_topGO_260829/figures/GO_term_enrichment_weight01_fisher.pdf",
